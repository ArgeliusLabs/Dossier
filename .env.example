# Copy to .env (never commit .env). Environment variables already set take precedence.

# --- OpenAI (default) ---
# OPENAI_API_KEY=sk-...
# DOSSIER_LLM_MODEL=gpt-5.4-mini

# --- Local model via Ollama ---
# DOSSIER_LLM_BASE_URL=http://localhost:11434/v1
# DOSSIER_LLM_MODEL=qwen2.5-coder:14b

# --- Local model via LM Studio ---
# DOSSIER_LLM_BASE_URL=http://localhost:1234/v1
# DOSSIER_LLM_MODEL=your-loaded-model-name

# Optional
# DOSSIER_LLM_API_KEY=        # key for a non-OpenAI hosted endpoint; local servers don't need one
# DOSSIER_LLM_TIMEOUT=180
# DOSSIER_LLM_JSON_MODE=1     # set 0 if your server rejects response_format
